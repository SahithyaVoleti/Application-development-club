// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum AdminStatus {
  PENDING
  PENDING_OTP
  PENDING_APPROVAL
  TRUSTED_ADMIN
  REJECTED
  ACTIVE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  REGISTRATION_CLOSED
}

enum AttendanceStatus {
  present
  absent
  not_marked
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            Role        @default(STUDENT)
  status          AdminStatus @default(ACTIVE)
  studentId       String?
  staffId         String?     @unique
  department      String?
  designation     String?
  organization    String?
  year            String?
  section         String?
  phone           String?
  college         String?     @default("VFSTR / Vignan University")
  otpVerified     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  registrations          Registration[]
  certificates           Certificate[]
  createdEvents          Event[]                @relation("CreatedEvents")
  approvalRequests       AdminApprovalRequest[]

  @@map("users")
}

model AdminApprovalRequest {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminName       String
  adminEmail      String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvalToken   String?   @unique
  approvedBy      String?
  rejectedBy      String?
  decisionSource  String?   @default("DASHBOARD") // EMAIL | DASHBOARD
  decisionAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("admin_approval_requests")
}

model Club {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  department  String?  @default("CSE")
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AdminClubAssignment[]
  events      Event[]

  @@map("clubs")
}

model AdminClubAssignment {
  id          String    @id @default(uuid())
  adminId     String
  adminName   String
  adminEmail  String
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubName    String
  role        Role      @default(ADMIN)
  status      String    @default("ACTIVE") // ACTIVE | REMOVED
  assignedBy  String    @default("Super Admin")
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([adminId, clubId, status])
  @@map("admin_club_assignments")
}

model Event {
  id                     String      @id @default(uuid())
  clubId                 String?
  club                   Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  clubName               String?
  createdById            String?
  createdBy              User?       @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)
  title                  String
  category               String
  branches               String[]    @default([])
  description            String      @db.Text
  date                   String
  startTime              String
  endTime                String
  venue                  String
  organizer              String
  registrationDeadline   String
  capacity               Int         @default(100)
  posterUrl              String      @db.Text
  eligibility            String      @db.Text
  rules                  String      @db.Text
  requirements           String      @db.Text
  contactPerson          String
  contactEmail           String
  allocatedBudget        Float       @default(0)
  certificateTemplateUrl String?     @db.Text
  isPublished            Boolean     @default(true)
  status                 EventStatus @default(UPCOMING)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @default(now()) @updatedAt

  registrations      Registration[]
  galleryImages      GalleryImage[]
  leaderboardEntries LeaderboardEntry[]
  certificates       Certificate[]

  @@map("events")
}

model NotificationLog {
  id            String   @id @default(uuid())
  recipient     String
  type          String   // ADMIN_REGISTRATION | ADMIN_APPROVED | ADMIN_REJECTED | CLUB_ADMIN_ASSIGNED | CLUB_ADMIN_REMOVED | EVENT_CREATION | EVENT_UPDATE | EVENT_DELETION | STUDENT_REGISTRATION
  subject       String
  sentDate      DateTime @default(now())
  status        String   @default("SUCCESS") // SUCCESS | FAILED
  relatedId     String?
  relatedUserId String?
  relatedClubId String?
  relatedEventId String?
  metadata      String?  @db.Text

  @@map("notification_logs")
}

model AuditLog {
  id              String   @id @default(uuid())
  actorId         String?
  actorEmail      String?
  performedBy     String
  action          String   // ADMIN_REGISTRATION | ADMIN_APPROVED | ADMIN_REJECTED | CLUB_ADMIN_ASSIGNED | CLUB_ADMIN_REMOVED | EVENT_CREATION | EVENT_UPDATE | EVENT_DELETION | STUDENT_REGISTRATION
  entityType      String   // USER | CLUB | EVENT | REGISTRATION | ASSIGNMENT
  entityId        String?
  rejectionReason String?
  metadata        String?  @db.Text
  createdAt       DateTime @default(now())

  @@map("audit_logs")
}

model Registration {
  id               String           @id @default(uuid())
  eventId          String
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentId        String
  studentName      String
  email            String
  mobile           String
  department       String
  year             String
  section          String
  gender           String           @default("Unspecified")
  skills           String           @default("")
  registrationDate DateTime         @default(now())
  registrationId   String           @unique
  attendanceStatus AttendanceStatus @default(not_marked)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  certificate Certificate?

  @@unique([studentId, eventId])
  @@map("registrations")
}

model Certificate {
  id             String        @id @default(uuid())
  certificateId  String        @unique
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  issuedAt       DateTime      @default(now())

  @@map("certificates")
}

model GalleryImage {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl String @db.Text
  caption  String

  @@map("gallery_images")
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  eventId         String?
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rank            Int
  teamName        String
  members         String
  projectName     String?
  points          Int      @default(0)
  projectsCount   Int      @default(1)
  hackathonsCount Int      @default(1)
  badge           String?
  award           String?
  createdAt       DateTime @default(now())

  @@map("leaderboard_entries")
}

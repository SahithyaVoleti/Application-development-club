# PostgreSQL / Supabase Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appdevhub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/appdevhub?schema=public"

# Auth Secret for JWT / Sessions
AUTH_SECRET="super-secret-adhub-jwt-key-2026"

# Email Configuration (Option A: Resend API Key, Option B: SMTP)
RESEND_API_KEY=""
EMAIL_FROM="CSE Application Development Hub <cse.events@vignan.ac.in>"

# Option B: Standard SMTP Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Default Admin Credentials for First Time Setup
ADMIN_DEFAULT_EMAIL="admin@appdevhub.com"
ADMIN_DEFAULT_PASSWORD="AdminPassword2026!"
